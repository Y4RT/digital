local function createNavButton(iconText, pageName, order)
	local btn = Instance.new("TextButton")
	btn.Name = pageName
	btn.Size = UDim2.new(0, 44, 0, 44)
	btn.Position = UDim2.new(0.5, -22, 0, 20 + (order * 52))
	btn.BackgroundColor3 = Theme.Surface
	btn.Text = iconText
	btn.TextColor3 = Theme.TextDim
	btn.TextSize = 18
	btn.Font = Enum.Font.GothamBold
	btn.BorderSizePixel = 0
	btn.AutoButtonColor = false
	btn.Parent = sidebar

	local corner = Instance.new("UICorner")
	corner.CornerRadius = UDim.new(0, 12)
	corner.Parent = btn

	btn.MouseEnter:Connect(function()
		if btn.BackgroundColor3 ~= Theme.Accent then
			TweenService:Create(btn, TweenInfo.new(0.15), {BackgroundColor3 = Theme.Surface2}):Play()
		end
	end)
	btn.MouseLeave:Connect(function()
		if headerTitle.Text ~= pageName then
			TweenService:Create(btn, TweenInfo.new(0.15), {BackgroundColor3 = Theme.Surface}):Play()
		end
	end)

	return btn
end

