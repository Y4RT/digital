local scale = Instance.new("UIScale", main)
local function fitToScreen()
	local size = screenGui.AbsoluteSize
	if size.X > 0 and size.Y > 0 then
		scale.Scale = math.min(1, (size.X - 20) / 900, (size.Y - 20) / 560)
	end
end
