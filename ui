<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Admin Panel</title>
<style>
  :root {
    --bg: #000000;
    --surface: #0a0a0a;
    --surface-2: #111111;
    --border: #1f1f1f;
    --text: #ffffff;
    --text-dim: #888888;
    --accent: #ffffff;
    --accent-glow: rgba(255, 255, 255, 0.15);
    --radius: 12px;
    --glow-strength: 0.4;
  }

  * {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
  }

  body {
    background: var(--bg);
    color: var(--text);
    height: 100vh;
    overflow: hidden;
    display: flex;
  }

  /* ===== SIDEBAR ===== */
  .sidebar {
    width: 72px;
    background: var(--surface);
    border-right: 1px solid var(--border);
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: 20px 0;
    gap: 8px;
    z-index: 10;
  }

  .nav-btn {
    width: 44px;
    height: 44px;
    border-radius: 12px;
    background: transparent;
    border: none;
    color: var(--text-dim);
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: all 0.2s ease;
    position: relative;
  }

  .nav-btn:hover {
    background: var(--surface-2);
    color: var(--text);
  }

  .nav-btn.active {
    background: var(--accent-glow);
    color: var(--accent);
    box-shadow: 0 0 20px var(--accent-glow);
  }

  .nav-btn svg {
    width: 20px;
    height: 20px;
  }

  .spacer {
    flex: 1;
  }

  /* ===== MAIN ===== */
  .main {
    flex: 1;
    display: flex;
    flex-direction: column;
    position: relative;
  }

  .header {
    height: 64px;
    border-bottom: 1px solid var(--border);
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0 28px;
    background: var(--surface);
  }

  .header h1 {
    font-size: 18px;
    font-weight: 500;
    letter-spacing: -0.3px;
  }

  .header-right {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .content {
    flex: 1;
    padding: 28px;
    overflow-y: auto;
    position: relative;
  }

  /* ===== PAGES ===== */
  .page {
    display: none;
    animation: fadeIn 0.25s ease;
  }

  .page.active {
    display: block;
  }

  @keyframes fadeIn {
    from { opacity: 0; transform: translateY(8px); }
    to   { opacity: 1; transform: translateY(0); }
  }

  .card {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 24px;
    margin-bottom: 20px;
  }

  .card h2 {
    font-size: 15px;
    font-weight: 500;
    margin-bottom: 16px;
    color: var(--text);
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
    gap: 16px;
  }

  .stat {
    background: var(--surface-2);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 20px;
  }

  .stat .label {
    font-size: 13px;
    color: var(--text-dim);
    margin-bottom: 6px;
  }

  .stat .value {
    font-size: 24px;
    font-weight: 500;
  }

  /* ===== BUTTONS ===== */
  .btn {
    background: var(--surface-2);
    border: 1px solid var(--border);
    color: var(--text);
    padding: 10px 18px;
    border-radius: 10px;
    cursor: pointer;
    font-size: 13px;
    transition: all 0.15s ease;
  }

  .btn:hover {
    background: var(--accent-glow);
    border-color: var(--accent);
    color: var(--accent);
  }

  .btn-primary {
    background: var(--accent);
    color: #000;
    border: none;
  }

  .btn-primary:hover {
    opacity: 0.9;
    box-shadow: 0 0 20px var(--accent-glow);
  }

  /* ===== THEME PANEL ===== */
  .theme-panel {
    position: fixed;
    top: 0;
    right: -360px;
    width: 340px;
    height: 100%;
    background: var(--surface);
    border-left: 1px solid var(--border);
    padding: 28px;
    transition: right 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    z-index: 100;
    overflow-y: auto;
  }

  .theme-panel.open {
    right: 0;
  }

  .theme-panel h2 {
    font-size: 16px;
    margin-bottom: 24px;
  }

  .setting {
    margin-bottom: 22px;
  }

  .setting label {
    display: block;
    font-size: 13px;
    color: var(--text-dim);
    margin-bottom: 8px;
  }

  input[type="color"] {
    width: 100%;
    height: 40px;
    border: none;
    border-radius: 8px;
    background: none;
    cursor: pointer;
  }

  input[type="range"] {
    width: 100%;
    accent-color: var(--accent);
  }

  .toggle-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .toggle {
    width: 44px;
    height: 24px;
    background: var(--surface-2);
    border-radius: 12px;
    position: relative;
    cursor: pointer;
    border: 1px solid var(--border);
  }

  .toggle::after {
    content: '';
    position: absolute;
    width: 18px;
    height: 18px;
    background: var(--text);
    border-radius: 50%;
    top: 2px;
    left: 2px;
    transition: 0.2s;
  }

  .toggle.on {
    background: var(--accent);
  }

  .toggle.on::after {
    left: 22px;
    background: #000;
  }

  .overlay {
    position: fixed;
    inset: 0;
    background: rgba(0,0,0,0.5);
    opacity: 0;
    pointer-events: none;
    transition: 0.3s;
    z-index: 90;
  }

  .overlay.show {
    opacity: 1;
    pointer-events: auto;
  }

  /* utility */
  .row {
    display: flex;
    gap: 12px;
    flex-wrap: wrap;
  }
</style>
</head>
<body>

<!-- SIDEBAR -->
<div class="sidebar">
  <button class="nav-btn active" data-page="dashboard" title="Dashboard">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg>
  </button>
  <button class="nav-btn" data-page="players" title="Players">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
  </button>
  <button class="nav-btn" data-page="world" title="World">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><path d="M2 12h20"/><path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/></svg>
  </button>
  <button class="nav-btn" data-page="logs" title="Logs">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/></svg>
  </button>

  <div class="spacer"></div>

  <button class="nav-btn" id="themeBtn" title="Theme Settings">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="3"/><path d="M12 1v2M12 21v2M4.22 4.22l1.42 1.42M18.36 18.36l1.42 1.42M1 12h2M21 12h2M4.22 19.78l1.42-1.42M18.36 5.64l1.42-1.42"/></svg>
  </button>
</div>

<!-- MAIN -->
<div class="main">
  <div class="header">
    <h1 id="pageTitle">Dashboard</h1>
    <div class="header-right">
      <button class="btn" onclick="document.getElementById('themeBtn').click()">Theme</button>
    </div>
  </div>

  <div class="content">

    <!-- DASHBOARD -->
    <div class="page active" id="dashboard">
      <div class="grid">
        <div class="stat">
          <div class="label">Online Players</div>
          <div class="value">24</div>
        </div>
        <div class="stat">
          <div class="label">Server Uptime</div>
          <div class="value">14h 32m</div>
        </div>
        <div class="stat">
          <div class="label">TPS</div>
          <div class="value">19.8</div>
        </div>
        <div class="stat">
          <div class="label">Memory</div>
          <div class="value">2.1 GB</div>
        </div>
      </div>

      <div class="card" style="margin-top:24px">
        <h2>Quick Actions</h2>
        <div class="row">
          <button class="btn btn-primary">Restart Server</button>
          <button class="btn">Broadcast Message</button>
          <button class="btn">Clear Chat</button>
          <button class="btn">Save World</button>
        </div>
      </div>
    </div>

    <!-- PLAYERS -->
    <div class="page" id="players">
      <div class="card">
        <h2>Player List</h2>
        <p style="color:var(--text-dim);font-size:14px;margin-bottom:16px">Click a player to manage them.</p>
        <div class="row">
          <button class="btn">Player_Alpha</button>
          <button class="btn">xXShadowXx</button>
          <button class="btn">NoobMaster69</button>
          <button class="btn">AdminBot</button>
        </div>
      </div>

      <div class="card">
        <h2>Player Actions</h2>
        <div class="row">
          <button class="btn">Kick</button>
          <button class="btn">Ban</button>
          <button class="btn">Teleport</button>
          <button class="btn">Spectate</button>
          <button class="btn">Give Item</button>
        </div>
      </div>
    </div>

    <!-- WORLD -->
    <div class="page" id="world">
      <div class="card">
        <h2>World Controls</h2>
        <div class="row">
          <button class="btn">Set Time to Day</button>
          <button class="btn">Set Time to Night</button>
          <button class="btn">Clear Weather</button>
          <button class="btn">Toggle PvP</button>
        </div>
      </div>
    </div>

    <!-- LOGS -->
    <div class="page" id="logs">
      <div class="card">
        <h2>Recent Logs</h2>
        <div style="font-family:monospace;font-size:13px;color:var(--text-dim);line-height:1.7">
          [07:02:14] Player_Alpha joined the game<br>
          [07:01:58] Server saved world<br>
          [07:00:12] xXShadowXx was teleported<br>
          [06:58:44] Broadcast: Welcome to the server!
        </div>
      </div>
    </div>

  </div>
</div>

<!-- THEME PANEL -->
<div class="overlay" id="overlay"></div>
<div class="theme-panel" id="themePanel">
  <h2>Theme Settings</h2>

  <div class="setting">
    <label>Accent Color</label>
    <input type="color" id="accentColor" value="#ffffff">
  </div>

  <div class="setting">
    <label>Glow Strength <span id="glowValue">0.4</span></label>
    <input type="range" id="glowStrength" min="0" max="1" step="0.05" value="0.4">
  </div>

  <div class="setting">
    <label>Border Radius <span id="radiusValue">12</span>px</label>
    <input type="range" id="borderRadius" min="0" max="24" step="1" value="12">
  </div>

  <div class="setting">
    <div class="toggle-row">
      <label style="margin:0">Light Mode</label>
      <div class="toggle" id="lightToggle"></div>
    </div>
  </div>

  <div class="setting" style="margin-top:32px">
    <button class="btn btn-primary" style="width:100%" onclick="resetTheme()">Reset to Default</button>
  </div>
</div>

<script>
  // Page switching
  const navButtons = document.querySelectorAll('.nav-btn[data-page]');
  const pages = document.querySelectorAll('.page');
  const pageTitle = document.getElementById('pageTitle');

  const titles = {
    dashboard: 'Dashboard',
    players: 'Players',
    world: 'World',
    logs: 'Logs'
  };

  navButtons.forEach(btn => {
    btn.addEventListener('click', () => {
      const page = btn.dataset.page;

      navButtons.forEach(b => b.classList.remove('active'));
      btn.classList.add('active');

      pages.forEach(p => p.classList.remove('active'));
      document.getElementById(page).classList.add('active');

      pageTitle.textContent = titles[page] || page;
    });
  });

  // Theme panel
  const themeBtn = document.getElementById('themeBtn');
  const themePanel = document.getElementById('themePanel');
  const overlay = document.getElementById('overlay');

  function openTheme() {
    themePanel.classList.add('open');
    overlay.classList.add('show');
  }
  function closeTheme() {
    themePanel.classList.remove('open');
    overlay.classList.remove('show');
  }

  themeBtn.addEventListener('click', openTheme);
  overlay.addEventListener('click', closeTheme);

  // Theme controls
  const root = document.documentElement;

  document.getElementById('accentColor').addEventListener('input', e => {
    root.style.setProperty('--accent', e.target.value);
    updateGlow();
  });

  document.getElementById('glowStrength').addEventListener('input', e => {
    document.getElementById('glowValue').textContent = e.target.value;
    root.style.setProperty('--glow-strength', e.target.value);
    updateGlow();
  });

  document.getElementById('borderRadius').addEventListener('input', e => {
    document.getElementById('radiusValue').textContent = e.target.value;
    root.style.setProperty('--radius', e.target.value + 'px');
  });

  function updateGlow() {
    const accent = getComputedStyle(root).getPropertyValue('--accent').trim();
    const strength = getComputedStyle(root).getPropertyValue('--glow-strength').trim();
    // simple conversion
    root.style.setProperty('--accent-glow', hexToRgba(accent, strength));
  }

  function hexToRgba(hex, alpha) {
    const r = parseInt(hex.slice(1,3), 16);
    const g = parseInt(hex.slice(3,5), 16);
    const b = parseInt(hex.slice(5,7), 16);
    return `rgba(${r}, ${g}, ${b}, ${alpha})`;
  }

  // Light mode toggle
  const lightToggle = document.getElementById('lightToggle');
  let isLight = false;

  lightToggle.addEventListener('click', () => {
    isLight = !isLight;
    lightToggle.classList.toggle('on', isLight);

    if (isLight) {
      root.style.setProperty('--bg', '#f5f5f5');
      root.style.setProperty('--surface', '#ffffff');
      root.style.setProperty('--surface-2', '#f0f0f0');
      root.style.setProperty('--border', '#e0e0e0');
      root.style.setProperty('--text', '#111111');
      root.style.setProperty('--text-dim', '#666666');
    } else {
      root.style.setProperty('--bg', '#000000');
      root.style.setProperty('--surface', '#0a0a0a');
      root.style.setProperty('--surface-2', '#111111');
      root.style.setProperty('--border', '#1f1f1f');
      root.style.setProperty('--text', '#ffffff');
      root.style.setProperty('--text-dim', '#888888');
    }
  });

  function resetTheme() {
    document.getElementById('accentColor').value = '#ffffff';
    document.getElementById('glowStrength').value = 0.4;
    document.getElementById('borderRadius').value = 12;
    document.getElementById('glowValue').textContent = '0.4';
    document.getElementById('radiusValue').textContent = '12';

    root.style.setProperty('--accent', '#ffffff');
    root.style.setProperty('--glow-strength', '0.4');
    root.style.setProperty('--radius', '12px');
    root.style.setProperty('--accent-glow', 'rgba(255,255,255,0.15)');

    if (isLight) {
      lightToggle.click(); // turn off light mode
    }
  }
</script>
</body>
</html>
