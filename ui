local function createButton(parent, text, isPrimary)
	local btn = Instance.new("TextButton")
	btn.Size = UDim2.new(0, 140, 0, 36)
	btn.BackgroundColor3 = isPrimary and Theme.Accent or Theme.Surface2
	btn.Text = text
	btn.TextColor3 = isPrimary and Color3.fromRGB(0,0,0) or Theme.Text
	btn.TextSize = 13
	btn.Font = Enum.Font.GothamMedium
	btn.BorderSizePixel = 0
	btn.AutoButtonColor = false
	btn.Parent = parent
	Instance.new("UICorner", btn).CornerRadius = UDim.new(0, 10)
	if not isPrimary then
		local stroke = Instance.new("UIStroke", btn)
		stroke.Color = Theme.Border
		stroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Border -- outline the button, not the text
	end

	btn.MouseEnter:Connect(function()
		TweenService:Create(btn, TweenInfo.new(0.15), {
			BackgroundColor3 = isPrimary and Theme.Accent:Lerp(Color3.new(1,1,1), 0.1) or Theme.Surface
		}):Play()
	end)
	btn.MouseLeave:Connect(function()
		TweenService:Create(btn, TweenInfo.new(0.15), {
			BackgroundColor3 = isPrimary and Theme.Accent or Theme.Surface2
		}):Play()
	end)

	return btn
end

